{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Foundation Studio",
  "version": "0.1.0",
  "identifier": "dev.bloooowfish.foundation-studio",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Foundation Studio",
        "width": 1380,
        "height": 860,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
